{
  "name": "Califnco - Expire unpaid stock reservations",
  "nodes": [
    {
      "id": "every-15-minutes",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "manual-cleanup",
      "name": "Manual cleanup",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "expire-unpaid-reservations",
      "name": "Expire unpaid reservations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 100],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PROJECT.vercel.app/api/maintenance/expire-orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 65000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SELECT_YOUR_CREDENTIAL",
          "name": "Califnco scheduler"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Expire unpaid reservations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual cleanup": {
      "main": [
        [
          {
            "node": "Expire unpaid reservations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "executionTimeout": 120
  },
  "pinData": {},
  "tags": []
}
