# Select one independent Vercel web app: admin, storefront, automation
CALIFNCO_APP=admin
# Copy to .env for LOCAL development. Set server secrets in Vercel environment settings.
# Public VITE_ / EXPO_PUBLIC_ variables are embedded in client builds. NEVER put secrets there.
DEMO_MODE=false
FIREBASE_PROJECT_ID=
# Entire JSON service-account object, on one line. Server only; never commit.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively, LOCAL only: GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path.json
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EAS_PROJECT_ID=
# Comma-separated origins if hosting the web UI separately. Native clients use bearer tokens.
ALLOWED_ORIGINS=
# Test mode only. Auto-capture must be enabled in Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Generate a random 32-byte secret locally. Use the same value in n8n's Header Auth credential.
CRON_SECRET=
AUTOMATION_TIMEZONE=Asia/Kolkata
AUTOMATION_ALERT_EMAIL=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# huggingface or gemini. Choose available model/provider in your own account.
AI_IMAGE_PROVIDER=huggingface
HF_TOKEN=
HF_IMAGE_MODEL=
HF_PROVIDER=auto
GEMINI_IMAGE_MODEL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
INSTAGRAM_PUBLISH_ENABLED=false
INSTAGRAM_LOGIN_TYPE=instagram
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Use a supported version for your Meta app; intentionally no guessed version.
META_GRAPH_VERSION=
RESEND_API_KEY=
MAIL_FROM=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
